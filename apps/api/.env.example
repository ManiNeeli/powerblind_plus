# ============================================================
# PowerBlind+ API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (SQLite for local dev) ---
# To switch to Postgres: change prisma/schema.prisma provider to "postgresql"
# and set DATABASE_URL to your Postgres connection string, e.g.:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/powerblind"
DATABASE_URL="file:../../../packages/db/prisma/dev.db"

# --- JWT ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000

# --- Seed admin account (dev only — change password after first login) ---
SEED_ADMIN_EMAIL=admin@powerblind.local
SEED_ADMIN_PASSWORD=    # leave blank to auto-generate on first seed run

# ============================================================
# PowerBlind+ API — PRODUCTION Environment Variables
# ============================================================
# Copy to apps/api/.env and fill in all values.
# NEVER commit this file with real secrets.
# In CI/CD, inject these as encrypted environment variables.

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ─────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=file:/data/powerblind.db

# PostgreSQL (recommended for production scale):
# DATABASE_URL=postgresql://user:password@postgres:5432/powerblind?schema=public

# ── JWT Secrets (MUST be changed — use 64+ random chars each) ─
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_A
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_B
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://yourdomain.com

# ── ML Service ───────────────────────────────────────────────
ML_SERVICE_URL=http://ml:8000

# ── Seed admin (first deploy only — remove after first login) ─
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=   # leave blank to auto-generate on first seed run
